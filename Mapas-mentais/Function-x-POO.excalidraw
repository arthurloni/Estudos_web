      "text": "class Botao {\n  constructor(elemento, cor) {\n    this.elemento = elemento; \n    this.cor = cor;         \n  }\n\n  alterarCor(novaCor) { \n    this.cor = novaCor;\n    this.elemento.style.backgroundColor = novaCor;\n  }\n}",
      "fontSize": 29.60000000000003,
      "baseFontSize": null,
