      "text": "Por que estruturas de dados são importantes?",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por que estruturas de dados são importantes?",
