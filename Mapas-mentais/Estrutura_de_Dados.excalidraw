    {
      "id": "RA8SjZsyKT_YMCc9Y4jpg",
      "type": "text",
      "x": -352.25793650793685,
      "y": 729.063492063492,
      "width": 814.6178623743384,
      "height": 109.81481481481512,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
