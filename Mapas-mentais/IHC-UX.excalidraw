      "boundElements": null,
      "updated": 1789948208119,
      "created": 1789946842526,
      "link": null,
      "locked": false,
      "text": "Interação Usuário-Sistema\nO diálogo bidirecional de ações, interpretações e feedback\nmútuo entre o ser humano e o artefato computacional para\nalcançar objetivos em determinado contexto.",
      "fontSize": 71.2249887162221,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interação Usuário-Sistema\nO diálogo bidirecional de ações, interpretações e feedback\nmútuo entre o ser humano e o artefato computacional para\nalcançar objetivos em determinado contexto.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Ji_zaWcrsusRJgqxnlDnj",
      "type": "text",
