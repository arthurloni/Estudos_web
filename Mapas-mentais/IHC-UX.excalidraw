      "boundElements": [],
      "updated": 1789940419902,
      "created": 1789351120291,
      "link": null,
      "locked": false,
      "text": "Lineares são aqueles que organizar os elementos de forma sequencial, ou melhor, um trás do outro.",
      "fontSize": 20.000000000000004,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lineares são aqueles que organizar os elementos de forma sequencial, ou melhor, um trás do outro.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "v5Vd9Ppm4Jh6OLujAiRqO",
      "type": "arrow",
      "x": -214.23701973566955,
