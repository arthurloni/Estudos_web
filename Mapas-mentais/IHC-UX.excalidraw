    {
      "id": "NTn3PtlTOfF-UTP6KIQTF",
      "type": "text",
      "x": 3104.1427140886144,
      "y": 345.3854239848191,
      "width": 2635.6406663737994,
      "height": 459.0740966796873,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
