      "created": 1789941460675,
      "link": null,
      "locked": false,
      "text": "O que é IHC?",
      "fontSize": 53.23127547691226,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O que é IHC?",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "cTsmCzw-SL4jHQpmz-lY-",
      "type": "text",
      "x": -2222.096360951611,
      "y": 14.831262664708447,
      "width": 2126.956733421426,
      "height": 286.62249470668866,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "eEugZMakbT3TtX62QXLGA"
      ],
      "frameId": null,
      "index": "b38",
      "roundness": null,
      "seed": 1889814470,
      "version": 1047,
      "versionNonce": 1243456794,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789947239000,
      "created": 1789942039633,
      "link": null,
      "locked": false,
      "text": "O estudo de Interação Humano-Computador tem foco multidisciplinar em várias áreas importantes:\nComputação, Artes, Design, Ergonomia, Psicologia, Sociologia, Semiótica e Linguística.\nA IHC estuda como as pessoas interagem com sistemas computacionais, para compreender e melhorar\na inserção da tecnologia na vida delas, buscando bem-estar e produtividade. Por isso, o sistema deve\nser pensado para o uso: facilitar a vida do usuário e reduzir a frustração.",
      "fontSize": 45.859599153070185,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O estudo de Interação Humano-Computador tem foco multidisciplinar em várias áreas importantes: Computação, Artes, Design, Ergonomia, Psicologia, Sociologia, Semiótica e Linguística.\nA IHC estuda como as pessoas interagem com sistemas computacionais, para compreender e melhorar a inserção da tecnologia na vida delas, buscando bem-estar e produtividade. Por isso, o sistema deve ser pensado para o uso: facilitar a vida do usuário e reduzir a frustração.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
