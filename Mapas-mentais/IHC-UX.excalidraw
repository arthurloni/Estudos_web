    {
      "id": "_NZ-meEO0III58o--e44L",
      "type": "text",
      "x": 746.1504456060557,
      "y": 607.4535895596268,
      "width": 953.9392700195312,
      "height": 25.000000000000004,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "K_G4L0bqiBEok1dKofZZM"
