      "updated": 1789940419902,
      "created": 1789350340139,
      "link": null,
      "locked": false,
      "text": "Como categorizamos as estrutura de dados?\n\n",
      "fontSize": 21.751824817518212,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Como categorizamos as estrutura de dados?\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "aPBK2eQnl_RBS_EPR26hx",
      "type": "rectangle",
      "x": 754.3448900505016,
      "y": 540.9258117818517,
      "width": 482.1654501216536,
      "height": 33.83617193836163,
      "angle": 0,
      "strokeColor": "#1e1e1e",
