      "roundness": null,
      "seed": 106521818,
      "version": 786,
      "versionNonce": 836333146,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "aDy2josYtr4vPgT9lvEeH",
          "type": "arrow"
        }
      ],
      "updated": 1789947823671,
      "created": 1789947263017,
      "link": null,
      "locked": false,
      "text": "affordance referese às propriedades físicas reais e perceptíveis entre um objeto\ne um agente que determinam como ele pode ser usado.\nExemplo: Um botão físico oferece (affords) ser pressionado; uma\nalça oferece ser puxada.\n",
      "fontSize": 73.45185546874991,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "affordance referese às propriedades físicas reais e perceptíveis entre um objeto e um agente que determinam como ele pode ser usado.\nExemplo: Um botão físico oferece (affords) ser pressionado; uma\nalça oferece ser puxada.\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
