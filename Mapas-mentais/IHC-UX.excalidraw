      "link": null,
      "locked": false,
      "text": "Por que estruturas de dados são importantes?",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por que estruturas de dados são importantes?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IqeV5XrYR9bHOHQ_4E0kg",
      "type": "rectangle",
      "x": -200.45924195789166,
      "y": 396.9603005061077,
      "width": 467.7777777777777,
      "height": 33.33333333333326,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
