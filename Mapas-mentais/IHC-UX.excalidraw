    {
      "id": "dQtdGAf5k4z9fzLQIi9JZ",
      "type": "text",
      "x": 1693.8482450337879,
      "y": 1506.3826343011806,
      "width": 705.9343261718743,
      "height": 455,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "K_G4L0bqiBEok1dKofZZM"
      ],
      "frameId": null,
      "index": "b1OX",
      "roundness": null,
      "seed": 1421354202,
      "version": 1605,
      "versionNonce": 2054415770,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789940419902,
      "created": 1789851049962,
      "link": null,
      "locked": false,
      "text": "Temos 3 tipos de Linked List (Lista encadeada)\nNotação O(1) , O(n)\n\n1° - Lista encadeada com fim nulo, onde varios Nós\nse liga até chegar em um final vazio.\n\n\n2° - Lista encadeada com ligação dupla, onde a\ninformção não segue apenas do começo ao fim, mas\ndo fim ao começo, fim nulo.\n\n3° - Lista encadeada circular, onde a informção não\nfica nulo, mas sim volta para o começo de tudo.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Temos 3 tipos de Linked List (Lista encadeada)\nNotação O(1) , O(n)\n\n1° - Lista encadeada com fim nulo, onde varios Nós se liga até chegar em um final vazio.\n\n\n2° - Lista encadeada com ligação dupla, onde a informção não segue apenas do começo ao fim, mas do fim ao começo, fim nulo.\n\n3° - Lista encadeada circular, onde a informção não fica nulo, mas sim volta para o começo de tudo.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
