      "boundElements": null,
      "updated": 1789948208119,
      "created": 1789946683124,
      "link": null,
      "locked": false,
      "text": "A interação tem o foco principal na ação do usuario com o computador\nEnquanto a Interface tem a ação da visibilidade dos botões do sistema, cores etc...",
      "fontSize": 79.05729484770208,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A interação tem o foco principal na ação do usuario com o computador\nEnquanto a Interface tem a ação da visibilidade dos botões do sistema, cores etc...",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2M0gkb0PCy_KFfcLbHvXd",
      "type": "text",
      "x": 4651.877976658961,
      "y": -644.2361270673164,
