      "link": null,
      "locked": false,
      "text": "Lineares são aqueles que organizar os elementos de forma sequencial, ou melhor, um trás do outro.",
      "fontSize": 20.000000000000004,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lineares são aqueles que organizar os elementos de forma sequencial, ou melhor, um trás do outro.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
