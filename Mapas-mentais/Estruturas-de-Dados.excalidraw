    {
      "id": "VgQVZPxsZUQUS0-WMgMbW",
      "type": "text",
      "x": 756.0741435226989,
      "y": 283.98136733740733,
      "width": 891.0581814236364,
      "height": 159.44444444444505,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
