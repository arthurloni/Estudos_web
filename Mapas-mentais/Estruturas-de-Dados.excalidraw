      "boundElements": [],
      "updated": 1789352285577,
      "created": 1789350340139,
      "link": null,
      "locked": false,
      "text": "Como categorizamos as estrutura de dados?\n\n",
      "fontSize": 21.751824817518212,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Como categorizamos as estrutura de dados?\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "aPBK2eQnl_RBS_EPR26hx",
      "type": "rectangle",
      "x": -356.70238095238125,
      "y": 1134.8968253968253,
      "width": 482.1654501216536,
      "height": 33.83617193836163,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "xUy_XVqwryXZOHkqrlBW3"
      ],
