      "seed": 1968405463,
      "version": 1510,
      "versionNonce": 400175814,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "1bWjDjxcq83ZfFskbww0t",
          "type": "arrow"
        }
      ],
      "updated": 1789853302350,
      "created": 1789350397647,
      "link": null,
      "locked": false,
      "text": "Não lineares, não seguimos a mesma logica sequencial e linear, trabalhamos com pontos de dados que\npodem ser ordenados hirearquicamente ou conectados em uma rede, \nComo não estão conectados uns aos outros em uma unica linha, os elementos não podem ser\npercorridos e acessados em uma unica execução, como acontece em uma estrutura de dados linear\n",
      "fontSize": 20.00000000000002,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Não lineares, não seguimos a mesma logica sequencial e linear, trabalhamos com pontos de dados que podem ser ordenados hirearquicamente ou conectados em uma rede, \nComo não estão conectados uns aos outros em uma unica linha, os elementos não podem ser percorridos e acessados em uma unica execução, como acontece em uma estrutura de dados linear\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
