    {
      "id": "ObddClF2haPIhQymn_iQB",
      "type": "text",
      "x": 749.5301656581405,
      "y": 634.398034004073,
      "width": 972.5767279730906,
      "height": 125.00000000000014,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
