    {
      "id": "Sc5kx6zpfKeGNo_Eu979K",
      "type": "text",
      "x": -343.36904761904776,
      "y": 536.8412698412702,
      "width": 827.1739718967026,
      "height": 141.1111111111113,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "xUy_XVqwryXZOHkqrlBW3"
      ],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 637064921,
      "version": 618,
      "versionNonce": 41275145,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789352285577,
      "created": 1789349535039,
      "link": null,
      "locked": false,
      "text": "Uma estrutura de dados e uma maneira de formatar dados, \npara que eles possam ser utilizados por programa de computador ou sistemas, \nAs estruturas de dados são fundamentais, pois dão forma a pontos de dados abstratos, \npermitindo que os usuários e sistemas trabalhem e armazenem dados de forma eficiente.\nQuando trabalhamos com estrutura de dados trabalhamos com dados primitivos, \ncomo Números inteiros ou real, caracteres e booleanos em um formato coesivo.",
      "fontSize": 18.814814814814838,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uma estrutura de dados e uma maneira de formatar dados, \npara que eles possam ser utilizados por programa de computador ou sistemas, \nAs estruturas de dados são fundamentais, pois dão forma a pontos de dados abstratos, \npermitindo que os usuários e sistemas trabalhem e armazenem dados de forma eficiente.\nQuando trabalhamos com estrutura de dados trabalhamos com dados primitivos, \ncomo Números inteiros ou real, caracteres e booleanos em um formato coesivo.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
